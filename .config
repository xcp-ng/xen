# -*- mode: Makefile; -*-

# Perform a debug build for trunk
debug := y

# Always produce debug symbols for debuginfo RPMs
debug_symbols := y

# Enable all config options
XEN_CONFIG_EXPERT := y
export XEN_CONFIG_EXPERT

# No tests
CONFIG_TESTS := n

# No remus netbuffering
override CONFIG_REMUS_NETBUF := n
